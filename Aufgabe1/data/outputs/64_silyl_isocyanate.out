    2 N      -2.548   -4.816   -0.364   -2.801   -4.519   -0.320   -2.587   -5.047   -0.634   -0.270
    3 C      -2.184   -3.647    0.169   -2.294   -3.455    0.252   -2.212   -3.349    0.440    0.271
